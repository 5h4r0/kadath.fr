# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (emails transactionnels)
RESEND_API_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Umami analytics (zone publique uniquement)
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# URLs — local : voir docs/local-dev-hosts.md pour la config /etc/hosts
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MANAGE_URL=http://localhost:3000/fr/manage
FORCE_ADMIN_HOST=false

# CookieYes — bannière de consentement. Désactivée en local par défaut :
# mettre "true" pour la tester. L'identifiant vient de l'URL du script fourni
# par CookieYes (https://cdn-cookieyes.com/client_data/<ID>/script.js).
NEXT_PUBLIC_COOKIEYES_ENABLED=false
NEXT_PUBLIC_COOKIEYES_ID=ef1fc7682b16315dca7139faf311fc93
